#include <bits/stdc++.h>
using namespace std;

//code

void solve(){
    int n, r, b;
    cin >> n >> r >> b;

    int base_r = r/(b+1);
    int extra_r = r%(b+1);

    for(int i=0; i<b+1; ++i){
        int count = base_r;

        if(i<extra_r) count=base_r+1;
        else count=base_r+0;

        for(int j=0; j<count; ++j){
            cout << 'R';
        }

        if(i<b) cout << 'B';
    }

    cout << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
