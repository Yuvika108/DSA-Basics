// Online C++ compiler to run C++ program online
#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n, k;
    cin >> n >> k;

    string s;
    cin >> s;

    int w_count=0;
    for(int i=0; i<k; i++){
        if(s[i]=='W') w_count++;
    }

    int min_w = w_count;

    for(int i=k; i<n; i++){
        if(s[i]=='W') w_count++;
        if(s[i-k]=='W') w_count--;

        min_w = min(min_w, w_count);
    }

    cout << min_w << "\n";
}

int main() {
    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
