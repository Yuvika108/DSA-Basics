#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    long long d;
    if (!(cin >> n >> d)) return 0;

    vector<long long> p(n);
    for (int i = 0; i < n; ++i) {
        cin >> p[i];
    }

    sort(p.begin(), p.end());

    int left = 0;
    int right = n - 1;
    int wins = 0;

    while (left <= right) {
        long long needed_players = (d / p[right]) + 1;

        if (right - left + 1 >= needed_players) {
            wins++;
            left += (needed_players - 1);
            right--;
        } else {
            break;
        }
    }

    cout << wins << "\n";

    return 0;
}
