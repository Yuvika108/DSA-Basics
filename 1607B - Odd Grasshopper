#include <iostream>

using namespace std;

void solve() {
    long long x0, n;
    cin >> x0 >> n;

    long long displacement = 0;
    long long rem = n % 4;

    if (rem == 1) {
        displacement = -n;
    } else if (rem == 2) {
        displacement = 1;
    } else if (rem == 3) {
        displacement = n + 1;
    } else {
        displacement = 0;
    }

    if (x0 % 2 == 0) {
        cout << x0 + displacement << endl;
    } else {
        cout << x0 - displacement << endl;
    }
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
