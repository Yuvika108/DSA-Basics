#include <bits/stdc++.h>
using namespace std;

void solve(){
    int w, h;
    cin >> w >> h;

    long long max_doubled_area = 0;

    for(int i=0; i<2; ++i){
        int k;
        cin >> k;

        vector<long long> x(k);
        for(int j=0; j<k; ++j) cin >> x[j];

        long long base = x.back()-x.front();

        max_doubled_area = max(max_doubled_area, base*h);
    }

    for(int i=0; i<2; ++i){
        int k;
        cin >> k;

        vector<long long> y(k);
        for(int j=0; j<k; ++j) cin >> y[j];

        long long base = y.back()-y.front();

        max_doubled_area = max(max_doubled_area, base*w);
    }

    cout << max_doubled_area << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
