#include <bits/stdc++.h>
using namespace std;
 
void solve(){
    int n;
    cin >> n;
    
    string s;
    cin >> s;
    
    vector<int> pref(n,0), suff(n,0);
    unordered_set<char> seen_pref, seen_suff;
    
    for(int i=0; i<n; ++i){
        seen_pref.insert(s[i]);
        pref[i] = seen_pref.size();
    }
    
    for(int i=n-1; i>=0; --i){
        seen_suff.insert(s[i]);
        suff[i] = seen_suff.size();
    }
    
    int max_distinct = 0;
    for(int i=0; i<n-1; ++i){
        max_distinct = max(max_distinct, pref[i]+suff[i+1]);
    }
    
    cout << max_distinct << "\n";
}
 
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    
    while(t--){
        solve();
    }
    
    return 0;
}
