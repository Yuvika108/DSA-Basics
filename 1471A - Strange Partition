#include <bits/stdc++.h>
using namespace std;

long long ceil_div(long long a, long long b){
    return (a + b - 1) / b;
}

void solve(){
    int n;
    long long x;

    cin >> n >> x;

    vector<long long> a(n);
    long long total_sum = 0;
    long long max_beauty = 0;

    for(int i = 0; i < n; i++){
        cin >> a[i];
        total_sum += a[i];
        max_beauty += ceil_div(a[i], x);
    }

    long long min_beauty = ceil_div(total_sum, x);

    cout << min_beauty << " " << max_beauty << "\n";
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
