#include <iostream>

using namespace std;

void solve() {
    long long a, b, c;
    cin >> a >> b >> c;

    // Case 1: Modify 'a' to get (new_a, b, c)
    // new_a = b - (c - b) = 2b - c
    long long new_a = 2 * b - c;
    if (new_a > 0 && new_a % a == 0) {
        cout << "YES" << endl;
        return;
    }

    // Case 2: Modify 'b' to get (a, new_b, c)
    // new_b = a + (c - a) / 2 = (a + c) / 2
    if ((a + c) % (2 * b) == 0) {
        // This checks if (a+c)/2 exists as an integer and is divisible by b
        cout << "YES" << endl;
        return;
    }

    // Case 3: Modify 'c' to get (a, b, new_c)
    // new_c = b + (b - a) = 2b - a
    long long new_c = 2 * b - a;
    if (new_c > 0 && new_c % c == 0) {
        cout << "YES" << endl;
        return;
    }

    cout << "NO" << endl;
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
