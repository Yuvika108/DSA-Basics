#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    if(!(cin >> n)) return;
    
    vector<int> p(n);
    for(int i; i<n; i++){
        cin >> p[i];
    }
    
    vector<int> left_min_idx(n);
    int min_idx = 0;
    for(int i=0; i<n; i++){
        if (p[i] < p[min_idx]){
            min_idx=i;
        }
        left_min_idx[i] = min_idx;
    }
    
    vector<int> right_min_idx(n);
    min_idx = n-1;
    for(int i=n-1; i>=0; --i){
        if (p[i] < p[min_idx]){
            min_idx=i;
        }
        right_min_idx[i] = min_idx;
    }
    
    bool found = false;
    for (int j = 1; j < n - 1; ++j) {
        int i = left_min_idx[j - 1];
        int k = right_min_idx[j + 1];
        if (p[i] < p[j] && p[k] < p[j]) {
            cout << "YES" << "\n";
            cout << (i + 1) << " " << (j + 1) << " " << (k + 1) << "\n";
            found = true;
            break;
        }
    }
    if (!found) {
        cout << "NO" << "\n";
    }
}

int main(){
    int t;
    cin >> t;
    
    while(t--){
        solve();
    }
    
    return 0;
}
