#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    
    vector<int> a(n), b(n);
    for(int i=0; i<n; i++) cin >> a[i];
    for(int i=0; i<n; i++) cin >> b[i];
    
    vector<int> max_a(2*n+1, 0);
    vector<int> max_b(2*n+1, 0);
    
    int current_len = 0;
    for(int i=0; i<n; i++){
        current_len++;
        if(i==n-1 || a[i]!=a[i+1]){
            max_a[a[i]] = max(max_a[a[i]], current_len);
            current_len = 0;
        }
    }
    
    current_len = 0;
    for(int i=0; i<n; i++){
        current_len++;
        if(i==n-1 || b[i]!=b[i+1]){
            max_b[b[i]] = max(max_b[b[i]], current_len);
            current_len = 0;
        }
    }
    
    int ans = 0;
    for(int i=1; i<=2*n; i++){
        ans = max(ans, max_a[i]+max_b[i]);
    }
    
    cout << ans << "\n";
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    
    while(t--){
        solve();
    }
    
    return 0;
}
