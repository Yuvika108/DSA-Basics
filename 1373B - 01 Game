#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s;
    cin >> s;
    
    int count0 = 0, count1 = 0;
    
    for(char c : s){
        if(c=='0') count0++;
        else count1++;
    }
    
    int min_moves = min(count0, count1);
    
    if(min_moves%2==1){
        cout << "DA\n";
    }else{ 
        cout << "NEt\n";
    }
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    
    while(t--){
        solve();
    }
    
    return 0;
}
