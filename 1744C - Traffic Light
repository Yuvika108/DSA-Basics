#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    char c;
    cin >> n >> c;
    string s;
    cin >> s;

    // If we are already looking for 'g', waiting time is 0
    if (c == 'g') {
        cout << 0 << "\n";
        return;
    }

    // Concatenate s to handle cyclic wrapping
    string s2 = s + s;
    int max_wait = 0;
    int last_g = -1;

    // Traverse s2 from right to left
    for (int i = 2 * n - 1; i >= 0; --i) {
        if (s2[i] == 'g') {
            last_g = i;
        }
        if (s2[i] == c && last_g != -1 && i < n) {
            max_wait = max(max_wait, last_g - i);
        }
    }

    cout << max_wait << "\n";
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
