#include <bits/stdc++.h>
using namespace std;

void solve(){
    string s;           //dlt any character --> Rs 1
    cin >> s;           //swap --> Rs 0
    
    int sum = 0;
    
    int count_0=0, count_1=0;
    
    for(int i=0; i<s.length(); i++){
       if(s[i]=='0') count_0++;
       else count_1++;
    }
    
    for(int i=0; i<s.length(); i++){
        if(s[i]=='0'){ 
            if(count_1>0){
                count_1--;
            }
            else{
                sum=s.length()-i;
                break;
            }
        }
        else{
            if(count_0>0){
                count_0--;
            }
            else{
                sum=s.length()-i;
                break;
            }
        }
    }
    cout << sum << "\n";
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    
    while(t--){
        solve();
    }
    
    return 0;
}
