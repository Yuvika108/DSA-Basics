// Online C++ compiler to run C++ program online
#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;

    vector<int> s(n);
    for(int i=0; i<n; i++){
        cin >> s[i];
    }

    vector<int> p(n);
    int l = 0;

    while(l<n){
        int r=l;
        while(r+1<n && s[r+1]==s[l]){
            r++;
        }
        if(l==r){
            cout << "-1\n";
            return;
        }

        p[l]=r+1;
        for(int i=l+1; i<=r; i++){
            p[i]=i;
        }

        l = r+1;
    }

    for (int i = 0; i < n; i++) {
        cout << p[i] << (i == n - 1 ? "" : " ");
    }
    cout << "\n";
}

int main() {
    int t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
